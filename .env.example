# Variables de entorno del frontend (Vite). Plantilla: cp .env.example .env
#
# ⚠ Las variables que empiezan por VITE_ acaban DENTRO del JavaScript que se
#   descarga el navegador: nunca pongas contraseñas ni secretos en el frontend.
#   Las de abajo (sin VITE_) solo las usa el servidor de desarrollo.

# Dirección del backend en producción (Render)
VITE_API_BASE_URL=https://backend-devops-university.onrender.com

# Dirección del backend local: el servidor de desarrollo Vite redirige /api/* allí cuando no se usa VITE_API_BASE_URL.
API_PROXY_TARGET=http://localhost:8090
